{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "esnext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "paths": {
      "@lib/*": ["./src/renderer/lib/*"],
      "@components/*": ["./src/renderer/components/*"],
      "@modules/*": ["./src/renderer/modules/*"],
      "@shared/*": ["./src/shared/*"],
      "@store/*": ["./src/renderer/store/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.config.ts",
    "forge.env.d.ts"
  ]
}
