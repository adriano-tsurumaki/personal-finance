    "drizzle-kit": "1.0.0-rc.4",
    "electron": "44.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lodash": "4.18.1",
    "prettier": "^3.9.6",
